{
  "name": "cabinet-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run sync && next dev",
    "sync": "node scripts/scaffold-source.mjs && node scripts/sync-content.mjs && node scripts/build-content.mjs",
    "build:content": "node scripts/build-content.mjs",
    "build": "npm run build:content && next build",
    "validate": "node scripts/validate.mjs",
    "preview": "npx serve out"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.14.0",
    "next": "^16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.17",
    "unified": "^11.0.5"
  },
  "overrides": {
    "postcss": "8.5.13"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.9.3"
  }
}
